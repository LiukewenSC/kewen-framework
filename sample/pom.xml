<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.cu.framework</groupId>
        <artifactId>cu-parent</artifactId>
        <version>0.2.1</version>
    </parent>

    <groupId>com.cu.framework.sample</groupId>
    <artifactId>sample</artifactId>
    <packaging>pom</packaging>

    <modules>
        <module>basic-boot-sample</module>
        <module>tenant-boot-sample</module>
        <module>storage-boot-sample</module>
        <module>auth-rbac-boot-sample</module>
        <module>login-boot-sample</module>
        <module>auth-core-boot-sample</module>
        <module>auth-rbac-security-boot-sample</module>
    </modules>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <build>
        <resources>
            <resource>
                <directory>${project.basedir}/src/main/resources</directory>
            </resource>
            <!-- 框架初始化脚本只有 relation/{模块} 一份，挂进各示例的 classpath:sql/ 供 spring.sql.init 使用，
                 避免在示例模块里手抄一份 DDL 造成两边漂移。
                 目录值按示例子模块的深度写（sample/<module>/../../relation/<module>），继承时
                 ${project.basedir} 以执行模块的上下文插值；子模块若自行声明 <resources> 会整体覆盖这里，
                 必须把它需要的目录一并写上。 -->
            <resource>
                <directory>${project.basedir}/../../relation/auth-rbac</directory>
                <targetPath>sql</targetPath>
                <includes>
                    <include>*.sql</include>
                </includes>
            </resource>
            <resource>
                <directory>${project.basedir}/../../relation/basic-support</directory>
                <targetPath>sql</targetPath>
                <includes>
                    <include>*.sql</include>
                </includes>
            </resource>
            <resource>
                <directory>${project.basedir}/../../relation/login-security</directory>
                <targetPath>sql</targetPath>
                <includes>
                    <include>*.sql</include>
                </includes>
            </resource>
        </resources>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <version>4.1.2</version>
            </plugin>
        </plugins>
    </build>

</project>