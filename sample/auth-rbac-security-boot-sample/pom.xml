<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.cu.framework.sample</groupId>
        <artifactId>sample</artifactId>
        <version>0.2.1</version>
    </parent>

    <artifactId>auth-rbac-security-boot-sample</artifactId>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <dependencies>
        <dependency>
            <groupId>com.cu.framework.auth</groupId>
            <artifactId>auth-rbac-security-spring-boot-starter</artifactId>
        </dependency>
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-jsqlparser-4.9</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <!-- 分页参数（PageReq）用 @NotNull 约束，需要校验实现才生效 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- spring-session-jdbc 需要 DataSource 与连接池，starter-jdbc 自带 HikariCP -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-jdbc</artifactId>
        </dependency>

        <!-- demo 默认使用 H2 内存库，无需本地 MySQL 即可启动；版本由 spring-boot-dependencies 管理 -->
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>runtime</scope>
        </dependency>
    </dependencies>

    <build>
        <!-- 子模块的 <resources> 是整体覆盖而非追加：父 pom 挂载的 relation/* 脚本必须在这里重写，
             否则框架建表脚本会从 classpath 上消失。本示例只需要 auth-rbac 与自己 sql/ 下的脚本。 -->
        <resources>
            <resource>
                <directory>${project.basedir}/src/main/resources</directory>
            </resource>
            <resource>
                <directory>${project.basedir}/../../relation/auth-rbac</directory>
                <targetPath>sql</targetPath>
                <includes>
                    <include>*.sql</include>
                </includes>
            </resource>
            <resource>
                <directory>${project.basedir}/sql</directory>
                <targetPath>sql</targetPath>
                <includes>
                    <include>*.sql</include>
                </includes>
            </resource>
        </resources>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <version>4.1.2</version>
                <configuration>
                    <mainClass>com.cu.framework.sample.AuthRbacSecurityBootSampleApp</mainClass>
                    <classifier>exec</classifier>
                    <layout>ZIP</layout>
                </configuration>
                <executions>
                    <execution>
                        <goals>
                            <goal>repackage</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

</project>
