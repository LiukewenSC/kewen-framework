<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.cu.framework.auth.rbac.composite.mapper.SysUserUnionCompositeMapper">

    <resultMap id="UserAuthObjectResult" type="com.cu.framework.auth.rbac.composite.model.UserAuthInfo">
        <!-- 父行鉴别列：一个用户多行 join 时靠它聚合成一个权限体，缺了它多部门用户会被拆成多个对象 -->
        <id property="userId" column="user_id"/>
        <!-- 用户权限体只对应一个用户，因此是 association 而不是 collection；
             写成 collection 会让 user 字段永不为 null 的前提落空，listBaseAuth 拿不到用户 -->
        <association property="user" javaType="com.cu.framework.auth.rbac.composite.model.User">
            <id property="id" column="user_id"/>
            <result property="name" column="user_name"/>
        </association>
        <collection property="depts" ofType="com.cu.framework.auth.rbac.composite.model.DeptWithParents">
            <id property="id" column="dept_id"/>
            <result property="name" column="dept_name"/>
        </collection>
        <collection property="roles" ofType="com.cu.framework.auth.rbac.composite.model.Role">
            <id property="id" column="role_id"/>
            <result property="name" column="role_name"/>
        </collection>
    </resultMap>
    <select id="getUserAuthInfo" resultMap="UserAuthObjectResult" >
        select u.id user_id, u.name user_name, d.id dept_id, d.name dept_name, r.id role_id, r.name role_name
        from sys_user u
                 left join sys_user_dept ud on u.id = ud.user_id
                 left join sys_dept d on ud.dept_id = d.id
                 left join sys_user_role ur on u.id = ur.user_id
                 left join sys_role r on ur.role_id = r.id
        where u.id = #{id}
    </select>

</mapper>
